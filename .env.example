APP_PORT="3001"
POSTGRES_DB="personal_command_center"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/personal_command_center?schema=public"
APP_URL="http://localhost:3001"
TZ="Asia/Bangkok"
APP_USER_EMAIL="nama@gmail.com"
APP_USER_NAME="Nama Anda"

# Wajib diisi untuk mengaktifkan kode akses. Gunakan password kuat pada deployment.
APP_PASSWORD="ganti-dengan-kata-sandi-kuat"
APP_SESSION_SECRET="ganti-dengan-rangkaian-acak-yang-panjang"

# Google Calendar resmi. Buat OAuth Web Client dan gunakan callback:
# http://localhost:3001/api/auth/google/callback
# GOOGLE_CALENDAR_ENABLED="false"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_CALENDAR_TIMEZONE="Asia/Bangkok"

# Push notification. Buat pasangan key sekali dengan: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# CRON_SECRET=""
