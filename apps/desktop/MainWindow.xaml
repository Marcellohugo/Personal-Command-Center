          <PasswordBox x:Name="LockConfirmInput" Margin="0,7,0,0" Height="46" MaxLength="6" FontSize="18" KeyDown="LockPinKeyDown" />
        </StackPanel>
        <TextBlock x:Name="LockStatus" Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#D65368" TextWrapping="Wrap" />
        <Button x:Name="UnlockButton" Margin="0,18,0,0" Height="48" Style="{StaticResource PrimaryButton}" Click="UnlockClick" Content="Buka dengan aman" />
        <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" Text="PIN dilindungi Windows DPAPI dan hanya berlaku di perangkat ini." TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
