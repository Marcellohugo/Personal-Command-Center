<Window x:Class="PersonalCommandCenter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marco Life OS"
        Width="1240"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon.png"
        Background="#F4F7FC"
        FontFamily="Segoe UI"
        Loaded="OnLoaded"
        StateChanged="WindowStateChanged">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#10213A" />
    <SolidColorBrush x:Key="Moss" Color="#2563EB" />
    <SolidColorBrush x:Key="Clay" Color="#0F6FEB" />
    <SolidColorBrush x:Key="Muted" Color="#66768D" />
    <SolidColorBrush x:Key="Line" Color="#DCE6F2" />
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#2563EB" />
      <GradientStop Offset="0.55" Color="#1557D6" />
      <GradientStop Offset="1" Color="#0B3D91" />
    </LinearGradientBrush>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="20" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#B8D4FF" /><Setter Property="Background" Value="#FCFDFF" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#7DD3FC" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="{StaticResource Ink}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#EAF2FF" />
      <Setter Property="Foreground" Value="{StaticResource Moss}" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#FFF0F3" />
      <Setter Property="Foreground" Value="#D65368" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C9D0CC" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="14,11" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#FAFCFF" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#FAFCFF" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style TargetType="DatePicker">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>

    <DataTemplate x:Key="TransactionRowTemplate">
      <Grid Margin="0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock FontWeight="SemiBold" Foreground="{StaticResource Ink}" Text="{Binding Title}" /><TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource Muted}" Text="{Binding DateLabel}" /></StackPanel>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding AmountColor}" Text="{Binding DisplayAmount}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="AgendaCompactTemplate">
      <Border Margin="0,4" Padding="10" Background="#F1F6FD" CornerRadius="10"><StackPanel><TextBlock FontWeight="SemiBold" Foreground="{StaticResource Ink}" Text="{Binding Title}" /><TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource Muted}" Text="{Binding StatusLabel}" /></StackPanel></Border>
    </DataTemplate>
    <DataTemplate x:Key="TransactionManageTemplate">
      <Border Margin="0,0,0,9" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Text="{Binding Title}" /><TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource Muted}" Text="{Binding DateLabel}" /></StackPanel><TextBlock Grid.Column="1" Margin="20,0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{Binding AmountColor}" Text="{Binding DisplayAmount}" /><Button Grid.Column="2" Margin="0,0,7,0" Style="{StaticResource SoftButton}" Tag="{Binding Id}" Click="EditTransactionClick" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Ubah transaksi" ToolTip="Ubah" /><Button Grid.Column="3" Style="{StaticResource DangerButton}" Tag="{Binding Id}" Click="DeleteTransactionClick" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Hapus transaksi" ToolTip="Hapus" /></Grid></Border>
    </DataTemplate>
    <DataTemplate x:Key="AgendaManageTemplate">
      <Border Margin="0,0,0,9" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Text="{Binding Title}" /><TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource Muted}" Text="{Binding DateLabel}" /></StackPanel><Button Grid.Column="1" Margin="0,0,7,0" Style="{StaticResource SoftButton}" Tag="{Binding Id}" Click="ToggleAgendaClick" Content="{Binding ToggleLabel}" /><Button Grid.Column="2" Margin="0,0,7,0" Style="{StaticResource SoftButton}" Tag="{Binding Id}" Click="EditAgendaClick" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Ubah agenda" ToolTip="Ubah" /><Button Grid.Column="3" Style="{StaticResource DangerButton}" Tag="{Binding Id}" Click="DeleteAgendaClick" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Hapus agenda" ToolTip="Hapus" /></Grid></Border>
    </DataTemplate>
    <DataTemplate x:Key="NoteManageTemplate">
      <Border Margin="0,0,0,9" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Text="{Binding Title}" /><TextBlock Margin="0,5,0,0" MaxHeight="44" Foreground="{StaticResource Muted}" Text="{Binding Body}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,7,0,0" FontSize="11" Foreground="#6981A4" Text="{Binding UpdatedLabel}" /></StackPanel><Button Grid.Column="1" Margin="18,0,7,0" VerticalAlignment="Top" Style="{StaticResource SoftButton}" Tag="{Binding Id}" Click="EditNoteClick" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Ubah catatan" ToolTip="Ubah" /><Button Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource DangerButton}" Tag="{Binding Id}" Click="DeleteNoteClick" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Hapus catatan" ToolTip="Hapus" /></Grid></Border>
    </DataTemplate>
    <DataTemplate x:Key="HabitManageTemplate">
      <Border Margin="0,0,0,9" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="36" Height="36" Margin="0,0,12,0" Background="{Binding StatusBackground}" CornerRadius="18"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding StatusColor}" Text="{Binding StatusIcon}" /></Border><StackPanel VerticalAlignment="Center"><TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Text="{Binding Name}" /><TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource Muted}" Text="{Binding StreakLabel}" /></StackPanel></StackPanel><Button Grid.Column="1" Margin="0,0,7,0" Style="{StaticResource SoftButton}" Tag="{Binding Id}" Click="ToggleHabitClick" Content="{Binding ToggleLabel}" /><Button Grid.Column="2" Margin="0,0,7,0" Style="{StaticResource SoftButton}" Tag="{Binding Id}" Click="EditHabitClick" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Ubah kebiasaan" ToolTip="Ubah" /><Button Grid.Column="3" Style="{StaticResource DangerButton}" Tag="{Binding Id}" Click="DeleteHabitClick" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Hapus kebiasaan" ToolTip="Hapus" /></Grid></Border>
    </DataTemplate>
    <DataTemplate x:Key="GrowthGoalTemplate">
      <Border Margin="0,0,0,9" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Text="{Binding Title}" /><TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource Muted}" Text="{Binding AreaLabel}" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource Moss}" Text="{Binding StatusLabel}" TextWrapping="Wrap" /><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource Muted}" Text="{Binding TargetLabel}" /></StackPanel><TextBlock Grid.Column="1" Margin="18,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Moss}" Text="{Binding ProgressLabel}" /><Button Grid.Column="2" Margin="0,0,7,0" Style="{StaticResource SoftButton}" Tag="{Binding Id}" Click="AdvanceGrowthGoalClick" Content="+10%" /><Button Grid.Column="3" Margin="0,0,7,0" Style="{StaticResource SoftButton}" Tag="{Binding Id}" Click="EditGrowthGoalClick" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Ubah tujuan" ToolTip="Ubah" /><Button Grid.Column="4" Style="{StaticResource DangerButton}" Tag="{Binding Id}" Click="DeleteGrowthGoalClick" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Hapus tujuan" ToolTip="Hapus" /></Grid></Border>
    </DataTemplate>
    <DataTemplate x:Key="FocusSessionTemplate">
      <Border Margin="0,0,0,8" Padding="14" Background="#F7FAFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="Bold" Foreground="{StaticResource Ink}" Text="{Binding Title}" /><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource Muted}" Text="{Binding SummaryLabel}" /><TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" Text="{Binding Note}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource DangerButton}" Tag="{Binding Id}" Click="DeleteFocusSessionClick" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Hapus sesi fokus" ToolTip="Hapus" /></Grid></Border>
    </DataTemplate>
    <DataTemplate x:Key="DailyReviewTemplate">
      <Border Margin="0,0,0,8" Padding="14" Background="#F7FAFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="Bold" Foreground="{StaticResource Ink}" Text="{Binding DateLabel}" /><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource Moss}" Text="{Binding ScoreLabel}" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="{Binding Win, StringFormat='Menang: {0}'}" TextWrapping="Wrap" /><TextBlock Margin="0,2,0,0" Foreground="{StaticResource Muted}" Text="{Binding Lesson, StringFormat='Pelajaran: {0}'}" TextWrapping="Wrap" /><TextBlock Margin="0,2,0,0" Foreground="{StaticResource Muted}" Text="{Binding NextStep, StringFormat='Berikutnya: {0}'}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource DangerButton}" Tag="{Binding Id}" Click="DeleteDailyReviewClick" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Hapus refleksi" ToolTip="Hapus" /></Grid></Border>
    </DataTemplate>
    <DataTemplate x:Key="TicketCardTemplate">
      <Border Margin="0,0,0,9" Padding="14" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontWeight="Bold" Foreground="{StaticResource Ink}" Text="{Binding Title}" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Clay}" Text="{Binding PriorityLabel}" /></Grid>
          <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource Moss}" Text="{Binding LabelsLabel}" TextWrapping="Wrap" />
          <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource Muted}"><Run Text="{Binding DueLabel}" /><Run Text=" · " /><Run Text="{Binding ChecklistLabel}" /></TextBlock>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Style="{StaticResource SoftButton}" Padding="8,5" Tag="{Binding Id}" Click="MoveTicketLeftClick" Content="←" ToolTip="Pindahkan ke kiri" /><Button Grid.Column="2" Margin="0,0,6,0" Style="{StaticResource SoftButton}" Padding="8,5" Tag="{Binding Id}" Click="EditTicketClick" Content="Detail" /><Button Grid.Column="3" Style="{StaticResource SoftButton}" Padding="8,5" Tag="{Binding Id}" Click="MoveTicketRightClick" Content="→" ToolTip="Pindahkan ke kanan" /></Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="TicketChecklistTemplate"><Border Margin="0,0,0,6" Padding="10" Background="#F3F7FD" CornerRadius="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Done}" IsHitTestVisible="False" /><TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource Ink}" Text="{Binding Text}" TextWrapping="Wrap" /><Button Grid.Column="2" Style="{StaticResource SoftButton}" Padding="7,4" Tag="{Binding Id}" Click="ToggleTicketChecklistClick" Content="Ubah" /></Grid></Border></DataTemplate>
    <DataTemplate x:Key="TicketCommentTemplate"><Border Margin="0,0,0,6" Padding="10" Background="#F3F7FD" CornerRadius="9"><StackPanel><TextBlock Foreground="{StaticResource Ink}" Text="{Binding Body}" TextWrapping="Wrap" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource Muted}" Text="{Binding DateLabel}" /></StackPanel></Border></DataTemplate>
  </Window.Resources>

  <Grid>
  <Grid x:Name="AppShell">
    <Grid.ColumnDefinitions><ColumnDefinition Width="238" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource Ink}" Padding="20,26">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
          <Border Width="52" Height="52" HorizontalAlignment="Left" CornerRadius="15"><Border.Background><ImageBrush ImageSource="Assets/AppIcon.png" Stretch="UniformToFill" /></Border.Background></Border>
          <TextBlock Margin="0,14,0,0" FontSize="11" FontWeight="Bold" Foreground="#79B7FF" Text="PERSONAL" />
          <TextBlock Margin="0,2,0,0" FontSize="20" FontWeight="Bold" Foreground="White" Text="Marco Life OS" />
          <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="#AFC9E8" Text="Native · lokal &amp; tersinkron" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,28,0,0">
          <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Tag="overview" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE80F;" /><TextBlock Text="Ringkasan" /></StackPanel></Button>
          <Button x:Name="TransactionsNav" Style="{StaticResource NavButton}" Tag="transactions" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE8C7;" /><TextBlock Text="Transaksi" /></StackPanel></Button>
          <Button x:Name="AgendaNav" Style="{StaticResource NavButton}" Tag="agenda" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE787;" /><TextBlock Text="Agenda" /></StackPanel></Button>
          <Button x:Name="NotesNav" Style="{StaticResource NavButton}" Tag="notes" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE70F;" /><TextBlock Text="Catatan" /></StackPanel></Button>
          <Button x:Name="HabitsNav" Style="{StaticResource NavButton}" Tag="habits" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE73E;" /><TextBlock Text="Kebiasaan" /></StackPanel></Button>
          <Button x:Name="ProjectsNav" Style="{StaticResource NavButton}" Tag="projects" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE8A9;" /><TextBlock Text="Proyek" /></StackPanel></Button>
          <Button x:Name="GrowthNav" Style="{StaticResource NavButton}" Tag="growth" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE9D2;" /><TextBlock Text="Perkembangan" /></StackPanel></Button>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="settings" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Width="28" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE713;" /><TextBlock Text="Pengaturan" /></StackPanel></Button>
        </StackPanel>
        <Border Grid.Row="3" Padding="14" Background="#102A52" CornerRadius="14">
          <StackPanel><TextBlock FontWeight="Bold" Foreground="White" Text="Mode offline" /><TextBlock Margin="0,5,0,10" FontSize="11" Foreground="#AFC9E8" TextWrapping="Wrap" Text="Tetap dapat dipakai tanpa internet; sinkron otomatis saat tersambung." /><Button Style="{StaticResource SoftButton}" Padding="10,7" Click="ExportBackupClick" Content="Ekspor cadangan" /><Button Margin="0,6,0,0" Style="{StaticResource SoftButton}" Padding="10,7" Click="ImportBackupClick" Content="Impor cadangan" /><Button Margin="0,6,0,0" Style="{StaticResource SoftButton}" Padding="10,7" Click="ResetDataClick" Content="Pulihkan data demo" /></StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Padding="34,24,34,18" Background="#FAFCFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource Clay}" Text="PUSAT KENDALI" /><TextBlock x:Name="HeaderTitle" Margin="0,3,0,0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}" Text="Ringkasan" /><TextBlock x:Name="HeaderSubtitle" Margin="0,4,0,0" Foreground="{StaticResource Muted}" Text="Semua yang penting untuk hari ini." /></StackPanel><TextBox x:Name="SearchInput" Grid.Column="1" Margin="18,0" VerticalAlignment="Center" ToolTip="Cari pada halaman aktif" TextChanged="SearchInputChanged" /><Border Grid.Column="2" VerticalAlignment="Center" Padding="12,7" Background="#E9F2FF" CornerRadius="14"><TextBlock x:Name="SyncStatusText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Moss}" Text="●  Tersimpan lokal" /></Border></Grid>
      </Border>

      <Grid Grid.Row="1" Margin="34,24,34,30">
        <ScrollViewer x:Name="OverviewPage" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Padding="28" Background="{StaticResource HeroGradient}" CornerRadius="24">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,26,0">
                  <TextBlock x:Name="GreetingText" FontSize="13" FontWeight="SemiBold" Foreground="#DCEBFF" Text="Selamat datang kembali" />
                  <TextBlock x:Name="MotivationText" Margin="0,7,0,0" MaxWidth="700" HorizontalAlignment="Left" FontSize="28" FontWeight="Bold" Foreground="White" Text="Satu langkah kecil hari ini tetap mengubah arah hidupmu." TextWrapping="Wrap" />
                  <TextBlock x:Name="CurrentDate" Margin="0,12,0,0" Foreground="#DCEBFF" />
                  <Button Margin="0,18,0,0" HorizontalAlignment="Left" Style="{StaticResource SoftButton}" Tag="growth" Click="NavigateClick" Content="Lihat perkembangan  →" />
                </StackPanel>
                <Border Grid.Column="1" Padding="18" VerticalAlignment="Stretch" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="18">
                  <StackPanel VerticalAlignment="Center">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="11" FontWeight="Bold" Foreground="#DCEBFF" Text="MISI HARI INI" /><TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="White" Text="&#xE1D9;" /></Grid>
                    <TextBlock x:Name="MissionText" Margin="0,13,0,0" FontSize="17" FontWeight="Bold" Foreground="White" Text="Tentukan satu langkah berikutnya." TextWrapping="Wrap" />
                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal"><TextBlock x:Name="OverviewGrowthScoreText" FontSize="28" FontWeight="Bold" Foreground="White" Text="0" /><TextBlock Margin="7,10,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#DCEBFF" Text="SKOR TUMBUH" /></StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <UniformGrid Margin="0,18,0,0" Columns="4">
              <Border Margin="0,0,9,0" Style="{StaticResource Card}"><StackPanel><TextBlock FontSize="12" Foreground="{StaticResource Muted}" Text="SALDO BERSIH" /><TextBlock x:Name="BalanceText" Margin="0,8,0,0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Ink}" /></StackPanel></Border>
              <Border Margin="3,0,6,0" Style="{StaticResource Card}"><StackPanel><TextBlock FontSize="12" Foreground="{StaticResource Muted}" Text="KELUAR BULAN INI" /><TextBlock x:Name="ExpenseText" Margin="0,8,0,0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Clay}" /></StackPanel></Border>
              <Border Margin="6,0,3,0" Style="{StaticResource Card}"><StackPanel><TextBlock FontSize="12" Foreground="{StaticResource Muted}" Text="AGENDA HARI INI" /><TextBlock x:Name="AgendaCountText" Margin="0,8,0,0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Ink}" /></StackPanel></Border>
              <Border Margin="9,0,0,0" Style="{StaticResource Card}"><StackPanel><TextBlock FontSize="12" Foreground="{StaticResource Muted}" Text="HABIT SELESAI" /><TextBlock x:Name="HabitCountText" Margin="0,8,0,0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Moss}" /></StackPanel></Border>
            </UniformGrid>
            <Border Margin="0,18,0,0" Padding="22" Background="#EEF5FF" BorderBrush="#C9DFFF" BorderThickness="1" CornerRadius="20">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0">
                  <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource Clay}" Text="DAILY OS" />
                  <TextBlock x:Name="LifeCycleText" Margin="0,5,0,0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}" Text="Siklus belum dimulai" />
                  <TextBlock x:Name="LifeXpText" Margin="0,5,0,14" Foreground="{StaticResource Muted}" Text="Level 1 · 0 XP" />
                  <WrapPanel>
                    <Button x:Name="StartCycleButton" Margin="0,0,7,7" Style="{StaticResource SoftButton}" Click="StartLifeCycleClick" Content="Mulai siklus 12 minggu" />
